# Kopie als keystore.properties (liegt in .gitignore) neben dieser Datei anlegen und ausfüllen.
# Den Schlüssel außerhalb des Repositorys aufbewahren – und sichern: Ohne ihn lassen sich Updates
# nicht mehr über die installierte App spielen (nur Deinstallieren, dabei gehen die App-Daten verloren).
storeFile=C:/Users/DEIN_NAME/.android/foody-release.jks
storePassword=
keyAlias=foody
keyPassword=
