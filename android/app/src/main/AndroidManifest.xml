<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FoodyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep Links foody://rezept|einkauf|kochen|tagebuch/… (Navigation Compose ordnet sie zu), foody://scannen und foody://foto (Widgets) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="foody" />
            </intent-filter>
        </activity>

        <!-- Homescreen-Widget „Scannen“: öffnet foody://scannen (ScanWidget). Exportiert, sonst fehlt es in der
             Widget-Liste mancher Hersteller-Launcher; onUpdate setzt nur den Knopf, ein fremdes APPWIDGET_UPDATE schadet nicht -->
        <receiver
            android:name=".widget.ScanWidget"
            android:exported="true"
            android:label="@string/widget_scan_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scan_widget_info" />
        </receiver>

        <!-- Homescreen-Widget „KI-Foto“: öffnet foody://foto (FotoWidget); exportiert wie „Scannen“ -->
        <receiver
            android:name=".widget.FotoWidget"
            android:exported="true"
            android:label="@string/widget_foto_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/foto_widget_info" />
        </receiver>

        <!-- Homescreen-Widget „Einkauf“ (EinkaufWidget): offene Artikel, Tipp öffnet die Liste; exportiert wie „Scannen“ -->
        <receiver
            android:name=".widget.EinkaufWidget"
            android:exported="true"
            android:label="@string/widget_einkauf_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/einkauf_widget_info" />
        </receiver>

        <!-- Homescreen-Widget „Schnell eintragen“: öffnet foody://eintragen (EintragenWidget) -->
        <receiver
            android:name=".widget.EintragenWidget"
            android:exported="true"
            android:label="@string/widget_eintragen_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/eintragen_widget_info" />
        </receiver>

        <!-- Homescreen-Widget „Heute“ (HeuteWidget): nächste Mahlzeit, kcal, Knöpfe „Kochen“ und „Eintragen“ -->
        <receiver
            android:name=".widget.HeuteWidget"
            android:exported="true"
            android:label="@string/widget_heute_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heute_widget_info" />
        </receiver>

        <!-- Homescreen-Widget „Kalorien“ (KalorienWidget): Ring mit dem Rest des Tagesziels, Tipp öffnet das Tagebuch -->
        <receiver
            android:name=".widget.KalorienWidget"
            android:exported="true"
            android:label="@string/widget_kalorien_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kalorien_widget_info" />
        </receiver>

        <!-- Homescreen-Widget „Woche“ (WocheWidget): Plan der Woche, Tipp öffnet foody://woche -->
        <receiver
            android:name=".widget.WocheWidget"
            android:exported="true"
            android:label="@string/widget_woche_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/woche_widget_info" />
        </receiver>

        <!-- WorkManager wird mit der HiltWorkerFactory selbst konfiguriert (FoodyApp) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
