<?xml version="1.0" encoding="utf-8"?>
<!-- Widget „Woche“ (WocheWidget): 4×1 Zellen; neu gezeichnet, wenn sich der Plan ändert, sonst alle 30 Minuten -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_woche_beschreibung"
    android:initialLayout="@layout/widget_woche"
    android:minWidth="250dp"
    android:minHeight="80dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="60dp"
    android:previewLayout="@layout/widget_woche"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
