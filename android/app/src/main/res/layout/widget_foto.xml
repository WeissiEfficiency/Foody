<?xml version="1.0" encoding="utf-8"?>
<!-- Widget „KI-Foto“: der ganze Knopf ist die Tippfläche (FotoWidget) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hintergrund"
    android:clipToOutline="true"
    android:contentDescription="@string/widget_foto_beschreibung"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_foto" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="@string/widget_foto_text"
        android:textColor="@color/widget_inhalt"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
