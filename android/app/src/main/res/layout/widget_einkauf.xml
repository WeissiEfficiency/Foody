<?xml version="1.0" encoding="utf-8"?>
<!-- Widget „Einkauf“ (EinkaufWidget): Kopf mit Titel und Anzahl, bis zu vier offene Artikel, unten der Rest.
     Schatten, Rand und Stempel nur in den Stilen (einkaufAnsicht). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_schatten"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_form"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/widget_rand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_form"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_knopf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_hintergrund"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_titel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_einkauf_titel"
                android:textColor="@color/widget_inhalt"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_stempel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_form"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_zahl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/widget_inhalt"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_zeile1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/widget_inhalt"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_zeile2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/widget_inhalt"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_zeile3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/widget_inhalt"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_zeile4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/widget_inhalt"
            android:textSize="13sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_fuss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/widget_inhalt"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
