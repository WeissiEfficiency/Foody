# Host-Name, unter dem Traefik den Server erreichbar macht
FOODY_HOST=foody.example.lan
# Name des externen Docker-Netzwerks, in dem Traefik läuft
TRAEFIK_NETWORK=traefik
# Traefik-Entrypoint (HTTPS)
TRAEFIK_ENTRYPOINT=websecure
# Name des Zertifikats-Resolvers in der Traefik-Konfiguration
TRAEFIK_CERTRESOLVER=letsencrypt
# Admin-Benutzername, wird nur beim ersten Start angelegt; danach leeren
FOODY_ADMIN_USER=
# Admin-Passwort, wird nur beim ersten Start gebraucht; danach leeren
FOODY_ADMIN_PASSWORD=
# Speichergrenze des Containers (Standard 512m; die JVM nimmt davon 75 %)
FOODY_MEM_LIMIT=512m
# KI-Hilfe (Phase 7): Schlüssel des Sprachmodell-Dienstes; leer = aus
FOODY_KI_KEY=
FOODY_KI_PRO_STUNDE=30
