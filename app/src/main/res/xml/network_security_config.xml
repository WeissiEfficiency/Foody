<?xml version="1.0" encoding="utf-8"?>
<!-- Nur HTTPS und nur System-Zertifizierungsstellen (keine Nutzer-CAs); Sync ist optional und braucht einen eigenen Server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
